# ==========================================
# DigitalFalconz Environment Variables
# ==========================================

# ------------------------------------------
# 1. GoHighLevel (GHL) Integration — REST API only
# ------------------------------------------
# The contact form sends each enquiry to GoHighLevel via the v2 REST API
# (POST https://services.leadconnectorhq.com/contacts/upsert). Set both
# values below. Until they are configured, enquiries are NOT delivered
# to GHL (the API route returns an error instead of a false success,
# so nothing is silently lost).
#
# GHL_API_KEY: a Private Integration token from HighLevel with the
# contacts.write scope. Create it in HighLevel under Settings ->
# Integrations -> Private Integrations (agency view), or ask the
# sub-account admin. Never commit a real key or paste one in chat.
# GHL_LOCATION_ID: the "Digital Falconz" sub-account.
GHL_API_KEY=
GHL_LOCATION_ID=dcts1IzmzaWnBUYWaPws

# ------------------------------------------
# 2. Email Notifications
# ------------------------------------------
# Recipient address for enquiry notifications:
NOTIFICATION_EMAIL=contact@digitalfalconz.com

# Method A: Standard SMTP (Google Workspace, Zoho, Microsoft 365, etc.)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@digitalfalconz.com
SMTP_PASS=
SMTP_FROM="DigitalFalconz" <contact@digitalfalconz.com>

# Method B: Resend (Alternative to SMTP if you use Resend)
# RESEND_API_KEY=
# RESEND_FROM="DigitalFalconz" <contact@digitalfalconz.com>
