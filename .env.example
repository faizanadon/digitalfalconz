# ==========================================
# DigitalFalconz Environment Variables
# ==========================================

# ------------------------------------------
# 1. GoHighLevel (GHL) Integration
# ------------------------------------------
# Option A: GHL Inbound Webhook (Recommended & Easiest)
# In GHL -> Automations -> Workflows -> Add Trigger: "Inbound Webhook"
# Paste the webhook URL provided by GoHighLevel:
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/YOUR_GHL_WEBHOOK_URL

# Option B: GHL Direct REST API (Alternative)
# If using GHL Location API v2 with API Key / Private Integration Token:
GHL_API_KEY=
GHL_LOCATION_ID=

# ------------------------------------------
# 2. Email Notifications
# ------------------------------------------
# Recipient address for enquiry notifications:
NOTIFICATION_EMAIL=contact@digitalfalconz.com

# Method A: Standard SMTP (Google Workspace, Zoho, Microsoft 365, etc.)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@digitalfalconz.com
SMTP_PASS=
SMTP_FROM="DigitalFalconz" <contact@digitalfalconz.com>

# Method B: Resend (Alternative to SMTP if you use Resend)
# RESEND_API_KEY=
# RESEND_FROM="DigitalFalconz" <contact@digitalfalconz.com>
